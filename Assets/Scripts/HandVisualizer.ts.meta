  InputLines:
    - '// @ui {"widget":"label", "label":"<b>Hand Visualizer</b> — draws the exact vector the classifier sees"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"group_start", "label":"Materials"}'
    - '// @input Asset.Material jointMaterial {"hint":"Unlit material for the joint spheres. Tinted at runtime by hold state — give it its own asset, not one shared with the panels."}'
    - '// @input Asset.Material boneMaterial {"hint":"Unlit material for the bones. A second asset, so bones can sit dimmer than joints."}'
    - '// @ui {"widget":"group_end"}'
    - '// @ui {"widget":"group_start", "label":"Layout"}'
    - '// @input float handScale = 5.5 {"hint":"Centimetres per unit of normalized hand space. One unit is wrist->middleKnuckle, so the drawn hand is roughly 2x this tall.", "widget":"slider", "min":1, "max":20, "step":0.5}'
    - '// @input vec3 offset = {0,0,2} {"hint":"Offset of the rig from this object, in centimetres. The default seats it in the gap between the two panels."}'
    - '// @input vec3 rotationDegrees = {0,180,0} {"hint":"Rig rotation in degrees. The normalized frame has +Z as the palm normal; the default turns the palm toward the wearer."}'
    - '// @input float jointRadius = 0.42 {"hint":"Radius of a joint sphere, in centimetres.", "widget":"slider", "min":0.05, "max":1.5, "step":0.05}'
    - '// @input float boneThickness = 0.26 {"hint":"Thickness of a bone, in centimetres.", "widget":"slider", "min":0.05, "max":1.5, "step":0.05}'
    - '// @ui {"widget":"group_end"}'
    - '// @ui {"widget":"group_start", "label":"Colour"}'
    - '// @input vec4 neutralColor = {0.36,0.58,0.88,1} {"hint":"Searching: a hand is tracked but nothing is accumulating.", "widget":"color"}'
    - '// @input vec4 warmColor = {1,0.72,0.18,1} {"hint":"Fully warmed: HoldBuffer progress at 1, a commit about to fire.", "widget":"color"}'
    - '// @input vec4 confirmColor = {0.24,0.94,0.46,1} {"hint":"Committed: pulsed on the frame a letter commits.", "widget":"color"}'
    - '// @input float confirmSeconds = 0.45 {"hint":"How long the commit pulse holds before falling back to neutral.", "widget":"slider", "min":0.05, "max":2, "step":0.05}'
    - '// @input float boneDimming = 0.55 {"hint":"Bone brightness relative to the joints. Below 1 makes the joints read as knuckles.", "widget":"slider", "min":0.2, "max":1, "step":0.05}'
    - '// @ui {"widget":"group_end"}'
    - '// @ui {"widget":"group_start", "label":"Behaviour"}'
    - '// @input bool hideWhenUntracked = true {"hint":"Hide the rig on untracked frames. On means the gaps in the input are visible as gaps — recommended, since the point is to show the real input."}'
    - '// @ui {"widget":"group_end"}'
