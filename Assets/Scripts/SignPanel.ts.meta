  InputLines:
    - '// @ui {"widget":"label", "label":"<b>Sign Panel</b> — outward-facing fingerspelling readout"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"group_start", "label":"Orientation"}'
    - '// @input bool faceOutward = true {"hint":"Rotate 180 degrees so the panel faces AWAY from the wearer. The reader is not the wearer. Turn OFF for a wearer-facing mirror of the same panel."}'
    - '// @ui {"widget":"group_end"}'
    - '// @ui {"widget":"group_start", "label":"Sections"}'
    - '// @input bool showHeader = true {"hint":"Show the small caption above the target word."}'
    - '// @input bool showTargetWord = true {"hint":"Show the target word with per-character progress. Signer feedback — belongs on the INWARD panel."}'
    - '// @input bool showAssembledText = true {"hint":"Show the assembled text. Reader-facing — belongs on the OUTWARD panel."}'
    - '// @input bool showConfidenceBar = true {"hint":"Show the confidence bar. Signer feedback — belongs on the INWARD panel."}'
    - '// @input bool showStatusLine = true {"hint":"Show the status line carrying the wrong-letter flash. Signer feedback — belongs on the INWARD panel."}'
    - '// @ui {"widget":"group_end"}'
    - '// @ui {"widget":"group_start", "label":"Layout"}'
    - '// @input float panelWidth = 42 {"hint":"Panel width in centimetres at the 110 cm focal plane.", "widget":"slider", "min":20, "max":60, "step":1}'
    - '// @input float rowGap = 1.6 {"hint":"Vertical gap between the word, the assembled text, the bar and the status line.", "widget":"slider", "min":0.5, "max":4, "step":0.1}'
    - '// @input float padding = 2.2 {"hint":"Inner padding on all four sides.", "widget":"slider", "min":1, "max":5, "step":0.1}'
    - '// @input float barHeight = 1.2 {"hint":"Height of the confidence bar.", "widget":"slider", "min":0.4, "max":2.5, "step":0.1}'
    - '// @ui {"widget":"group_end"}'
    - '// @ui {"widget":"group_start", "label":"Labels"}'
    - '// @input string headerLabel = "SIGNING" {"hint":"Small caption above the target word. Empty string hides it."}'
    - '// @input string emptyPlaceholder = "—" {"hint":"Shown in the assembled-text area before anything has been committed."}'
    - '// @ui {"widget":"group_end"}'
    - '// @ui {"widget":"group_start", "label":"Letter colours"}'
    - '// @input vec4 doneColor = {0.45,0.9,0.55,1} {"hint":"Characters already committed correctly.", "widget":"color"}'
    - '// @input vec4 currentColor = {1,1,1,1} {"hint":"The character being signed right now.", "widget":"color"}'
    - '// @input vec4 pendingColor = {1,1,1,0.5} {"hint":"Characters not yet reached.", "widget":"color"}'
    - '// @input vec4 skippedColor = {0.95,0.8,0.4,1} {"hint":"Characters that were skipped rather than signed.", "widget":"color"}'
    - '// @input vec4 wrongColor = {0.9,0.45,0.45,1} {"hint":"The current character while a wrong-letter flash is up, and the flash text itself.", "widget":"color"}'
    - '// @ui {"widget":"group_end"}'
    - '// @ui {"widget":"group_start", "label":"Text colours"}'
    - '// @input vec4 assembledColor = {1,1,1,1} {"hint":"The assembled text the reader is here to read. Keep this the brightest thing on the panel.", "widget":"color"}'
    - '// @input vec4 captionColor = {1,1,1,0.55} {"hint":"Header caption and the idle status line.", "widget":"color"}'
    - '// @ui {"widget":"group_end"}'
