  InputLines:
    - '// @ui {"widget":"label", "label":"<b>Sign Bridge</b> — hand → classifier → hold → phrase → panels"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"group_start", "label":"Wiring"}'
    - '// @input Asset.Asset templatesAsset {"hint":"templates.json, recorded by TemplateRecorder. Without it nothing can be classified."}'
    - '// @input AssignableType_1 inwardPanel {"hint":"Signer-facing panel: target word, confidence bar, wrong-letter flash."}'
    - '// @input AssignableType_2 outwardPanel {"hint":"Reader-facing panel: the assembled text."}'
    - '// @input AssignableType_3 mockHandInput {"hint":"Optional. When present, it is loaded with the template poses and replays them — Editor testing without hardware."}'
    - '// @ui {"widget":"group_end"}'
    - '// @ui {"widget":"group_start", "label":"Classifier"}'
    - "// @input string featureMode = \"full\" {\"hint\":\"Feature space distances are computed in. 'full' = 78 dims, 'reduced' = 57.\", \"widget\":\"combobox\", \"values\":[{\"label\":\"full\", \"value\":\"full\"}, {\"label\":\"reduced\", \"value\":\"reduced\"}]}"
    - "// @input float k = 1 {\"hint\":\"How many of a letter's nearest templates to average into its score.\", \"widget\":\"slider\", \"min\":1, \"max\":5, \"step\":1}"
    - '// @input float thumbWeight = 1 {"hint":"Weight on the thumb landmarks — the M/N/S/T separator. 1 = uniform. Remember weights hit SQUARED distance, so 2 is 4x the influence.", "widget":"slider", "min":1, "max":4, "step":0.25}'
    - '// @ui {"widget":"group_end"}'
    - '// @ui {"widget":"group_start", "label":"Hold buffer"}'
    - '// @input float windowFrames = 18 {"hint":"Window length in frames. 18 is about 0.6s at 30fps.", "widget":"slider", "min":6, "max":40, "step":1}'
    - '// @input float minMeanConfidence = 0.3 {"hint":"Mean confidence the winning letter must reach. PROVISIONAL until set from real data.", "widget":"slider", "min":0, "max":1, "step":0.05}'
    - '// @input float maxDistance {"hint":"Max template distance for a frame to count as a letter. 0 DISABLES the gate — calibrate from the _NEGATIVE separation.", "widget":"slider", "min":0, "max":10, "step":0.1}'
    - '// @input float rearmFrames = 3 {"hint":"Consecutive non-matching frames needed to re-arm after a commit. Separates a deliberate bounce from a one-frame glitch.", "widget":"slider", "min":1, "max":10, "step":1}'
    - '// @ui {"widget":"group_end"}'
    - '// @ui {"widget":"group_start", "label":"Session"}'
    - '// @input string signingHand = "right" {"hint":"The hand that signs. Ignored while a MockHandInput is the active source.", "widget":"combobox", "values":[{"label":"right", "value":"right"}, {"label":"left", "value":"left"}]}'
    - '// @input bool verbose = true {"hint":"Log a line on every commit, wrong letter and phrase completion."}'
    - '// @ui {"widget":"group_end"}'
